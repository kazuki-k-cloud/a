// 工数管理システム Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================
// NextAuth (Auth.js) 用モデル
// ==============================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==============================
// アプリケーション用モデル
// ==============================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  image         String?
  emailVerified DateTime?
  department    String?
  role          Role      @default(MEMBER)
  isActive      Boolean   @default(true) // 退職者はfalseにする
  joinedAt      DateTime?
  leftAt        DateTime?

  accounts    Account[]
  sessions    Session[]
  attendances Attendance[]
  timeEntries TimeEntry[]
  assignments ProjectAssignment[]

  createdAt DateTime @default(now())
}

enum Role {
  MEMBER
  MANAGER
  ADMIN
}

model Project {
  id         String        @id @default(cuid())
  name       String
  clientName String?
  status     ProjectStatus @default(ACTIVE)
  startDate  DateTime?
  endDate    DateTime?

  timeEntries TimeEntry[]
  assignments ProjectAssignment[]

  createdAt DateTime @default(now())
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ON_HOLD
}

// 誰がどの案件にアサインされているか（入力画面の候補を絞るため）
model ProjectAssignment {
  id        String  @id @default(cuid())
  userId    String
  projectId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, projectId])
}

// 勤務記録（出退勤・手入力）
model Attendance {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime // その日の日付（時刻部分は無視、UTC 00:00で正規化）
  clockIn      DateTime?
  clockOut     DateTime?
  breakMinutes Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, date])
}

// 工数記録（案件への時間配分）
model TimeEntry {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date      DateTime
  hours     Float // 0.5h単位を想定
  memo      String? // 任意メモ（自由記述は必須にしない）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, projectId, date])
}
