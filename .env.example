# Database
DATABASE_URL="postgresql://app:app@localhost:5432/koudo_db?schema=public"

# NextAuth (Auth.js v5)
AUTH_SECRET="generate-with-`openssl rand -base64 33`"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (Google Workspace SSO)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# 会社ドメイン制限（カンマ区切りで複数可。空の場合は制限なし）
ALLOWED_EMAIL_DOMAINS="example.com"

# メール送信（未入力リマインド）
# "mock" の場合はコンソールログ出力のみ。"gmail" の場合はGmail API連携（サービスアカウント要）
MAIL_PROVIDER="mock"
GMAIL_SERVICE_ACCOUNT_KEY=""
GMAIL_SENDER_EMAIL=""
APP_BASE_URL="http://localhost:3000"

# Cloud SchedulerからAPI経由でバッチを叩く際の共有シークレット
CRON_SECRET="generate-a-random-secret"
